#: po/keystr.h:2
msgid "The paper is not set correctly."
msgstr "Das Papier w. nicht richtig eingelegt."

#: po/keystr.h:4
msgid "The printer cover is open."
msgstr "Die Druckerabdeckung ist offen."

#: po/keystr.h:6
msgid "A paper jam has occurred."
msgstr "Ein Papierstau ist aufgetreten."

#: po/keystr.h:8
msgid "Check the printer."
msgstr "Überprüfen Sie den Drucker."

#: po/keystr.h:10
#, c-format
msgid "Support Code: %s"
msgstr "Supportcode: %s"

#: po/keystr.h:12
msgid "Preparing for printing..."
msgstr "Vorbereitung zum Drucken..."

#: po/keystr.h:14
msgid "Cannot communicate with the printer."
msgstr "Keine Kommunikation m. d. Drucker mögl."

#: po/keystr.h:16
msgid "The printer is busy."
msgstr "Der Drucker ist belegt."

#: po/keystr.h:18
msgid "Printing..."
msgstr "Drucken..."
