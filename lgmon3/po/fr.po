#: po/keystr.h:2
msgid "The paper is not set correctly."
msgstr "Le papier n'est pas défini correctement."

#: po/keystr.h:4
msgid "The printer cover is open."
msgstr "Le capot de l'imprimante est ouvert. "

#: po/keystr.h:6
msgid "A paper jam has occurred."
msgstr "Un bourrage papier s'est produit."

#: po/keystr.h:8
msgid "Check the printer."
msgstr "Vérifiez l'imprimante."

#: po/keystr.h:10
#, c-format
msgid "Support Code: %s"
msgstr "Code de support : %s"

#: po/keystr.h:12
msgid "Preparing for printing..."
msgstr "Préparation de l'impression..."

#: po/keystr.h:14
msgid "Cannot communicate with the printer."
msgstr "Impossible communiquer avec imprimante."

#: po/keystr.h:16
msgid "The printer is busy."
msgstr "L'imprimante est occupée."

#: po/keystr.h:18
msgid "Printing..."
msgstr "Impression en cours..."
