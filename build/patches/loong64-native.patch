 /* CNNET2 Functions */
+/* MAC 规范化：去掉分隔符（- : 空格）并统一大写。
+ * 上层给出的 serial 书写形式并不唯一（6C-3C-7C-A0-51-CB、6c3c7ca051cb、
+ * 6C:3C:7C:A0:51:CB 都见过），而 network2dev[].macAddressStr_ 固定是
+ * xx-xx-xx-xx-xx-xx。统一规范化后再比较，避免仅因大小写/分隔符差异
+ * 就匹配失败（表现为「网络打印机找不到」）。
+ * 注：官方 6.90 仍是裸 strcmp，未做规范化。 */
+static void cn_norm_mac( const char *in, char *out, size_t cap )
+{
+	size_t j = 0;
+
+	if( out == NULL || cap == 0 ) return;
+	if( in == NULL ){ out[0] = '\0'; return; }
+
+	for( ; *in != '\0' && j + 1 < cap; in++ ){
+		if( *in == '-' || *in == ':' || *in == ' ' ) continue;
+		out[j++] = (char)toupper( (unsigned char)*in );
+	}
+	out[j] = '\0';
+}
