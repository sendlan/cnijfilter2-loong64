 #include <sys/types.h>
 #include <sys/stat.h>
 #include <unistd.h>
-#include <libxml/parser.h>	/* Ver.2.80 */
+#include <libxml/parser.h>	/* Ver.2.80 —— 仅用其类型定义（编译期），函数走运行时绑定 */
+#include <dlfcn.h>
 #include <string.h>
 
+/* ------------------------------------------------------------------
+ *  libxml2 运行时兼容层（多发行版，2026-09-26）
+ *
+ *  为什么不直接链接 -lxml2：
+ *    libxml2 的 soname 在各发行版已经分叉 ——
+ *      Loongnix / Debian / Ubuntu : libxml2.so.2（2.9~2.12）
+ *      AOSC 13.3 / 新上游         : libxml2.so.16（2.14+）
+ *    硬编码任何一个都会让同一份二进制在另一边加载失败。
+ *
+ *  本文件只用到 4 个「跨代稳定」API：
+ *      xmlParseFile / xmlFreeDoc / xmlGetProp / xmlNodeGetContent
+ *  （已在 AOSC 的 libxml2.so.16 上用 nm 逐一核实存在；树结构的
+ *    children 字段偏移自 2.x 以来未变）。改为运行时按序 dlopen
+ *    探测，同一份二进制两端通用；全都找不到时优雅降级（返回 -1，
+ *    错误文案退化为 key 名），不影响打印数据通路。
+ *  注：官方 6.90 仍直接链接 -lxml2。
+ * ------------------------------------------------------------------ */
+static xmlDocPtr  (*p_xmlParseFile)(const char *);
+static void       (*p_xmlFreeDoc)(xmlDocPtr);
+static xmlChar *  (*p_xmlGetProp)(xmlNodePtr, const xmlChar *);
+static xmlChar *  (*p_xmlNodeGetContent)(xmlNodePtr);
+
+static int xml_bind(void)
+{
+	const char *cands[] = { "libxml2.so.2", "libxml2.so.16", "libxml2.so", NULL };
+	int i;
+
+	for( i = 0 ; cands[i] != NULL ; i++ ){
+		void *h = dlopen( cands[i], RTLD_LAZY );
+		if( h == NULL ) continue;
+		p_xmlParseFile      = (xmlDocPtr (*)(const char *))dlsym( h, "xmlParseFile" );
+		p_xmlFreeDoc        = (void (*)(xmlDocPtr))dlsym( h, "xmlFreeDoc" );
+		p_xmlGetProp        = (xmlChar *(*)(xmlNodePtr, const xmlChar *))dlsym( h, "xmlGetProp" );
+		p_xmlNodeGetContent = (xmlChar *(*)(xmlNodePtr))dlsym( h, "xmlNodeGetContent" );
+		if( p_xmlParseFile && p_xmlFreeDoc && p_xmlGetProp && p_xmlNodeGetContent )
+			return 0;
+		dlclose( h );
+	}
+	return -1;
+}
